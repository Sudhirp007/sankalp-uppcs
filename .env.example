# Neon Lakebase Postgres (auto-populated by `neon deploy` / `neon env pull`)
DATABASE_URL="postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"

# Firebase Authentication (Spark $0 Tier — Web Client + Stateless Edge JWT Verify)
FIREBASE_PROJECT_ID="sankalp-uppcs-app"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="sankalp-uppcs-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="sankalp-uppcs-app"
VITE_FIREBASE_APP_ID=""

# Razorpay Payments (Set your Test/Live keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
VITE_RAZORPAY_KEY_ID=""
