# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Free tier is roughly 10 RPM for flash models; raise on paid tiers.
GEMINI_RPM=10
GEMINI_MAX_RETRIES=5

# Crawler politeness
REQUEST_DELAY_MIN=1.5
REQUEST_DELAY_MAX=3.0
DOWNLOAD_CONCURRENCY=2

# OCR (auto-detected on Windows; set only if Tesseract lives elsewhere)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\path\to\tessdata
OCR_LANGUAGES=hin+eng
OCR_DPI=300

# Optional: alternative DB URL (default: sqlite:///data/harvester.db)
# HARVESTER_DB_URL=sqlite:///data/harvester.db
LOG_LEVEL=INFO
